<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".MageKnightBuddyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MageKnightBuddy">
        <!-- windowSoftInputMode="adjustResize" makes the window shrink when the soft keyboard
             opens, which is what makes WindowInsets.ime (and so Modifier.imePadding()) report a
             real height on API levels below 30. Without it the scoring wizard's Previous/Next row
             ends up hidden behind the keyboard (issue #173). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MageKnightBuddy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
