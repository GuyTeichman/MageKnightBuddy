<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- App-icon background layer: a near-white ground so the dark shield and gold
         emblem read with high contrast (and sit alongside the other light launcher
         icons). A faint warm-grey vignette toward the edges gives it a little depth
         without lowering contrast. Full-bleed so the launcher mask always has
         something to crop. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="80">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFEFECE4" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
