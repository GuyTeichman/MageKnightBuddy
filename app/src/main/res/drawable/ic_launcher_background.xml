<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- App-icon background layer: a full-bleed radial gradient in the app's indigo
         (#1B1035) family, lit slightly above centre so the gold emblem reads as
         catching light from above. Full-bleed so the launcher mask always has
         something to crop. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="76">
                <item android:offset="0" android:color="#FF241548" />
                <item android:offset="1" android:color="#FF0F0820" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
